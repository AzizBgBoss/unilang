getkeyword(gfx, 2:32)
getkeyword(kbd, 34:32)
isflagsupported(0, 1, 0:1)
if(0:1, 2:32)
print("This computer does not support 64x64@1 graphics.")
exit

-gfx-
print("This computer supports graphics.")
flag[0]=1

isflagsupported(1, 1, 1:1)
if(1:1, 34:32)
print("This computer does not support NES keyboard.")
exit

-kbd-
print("This computer supports keyboard.")
flag[1]=1

#
0:16 - parameter 1 (x)
16:16 - parameter 2 (y)
32:16 - parameter 3 (color)
48:32 - drawpixel address
#

getkeyword(drawpixel, 48:32)
getcur(112:32)
mem[0:16]=1
mem[16:16]=4
mem[32:16]=1
subroutine(48:32)

printn("Keyboard state: ")
out(4088:8)
print(" (hold a key and watch this value)")
sleep(100)
setcurv(112:32)

-drawpixel-

getmemsize(80:32)
sub(4104, 80:32, 144:32)
sub(8, 80:32, 80:32)
setmem(144:8, 80:8)
return

getmemsize(80:32)
sub(1, 80:32, 80:32)
out(80:32)
subv(80:32, 0:16, 80:32)
mul(64, 16:16, 16:16)
subv(80:32, 16:16, 80:32)
mem[144:32]=32
setmem(144:16, 80:1)
return